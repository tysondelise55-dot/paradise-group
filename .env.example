# Absolute site URL (no trailing slash). Defaults to https://paradisegroupx.com
NEXT_PUBLIC_SITE_URL=https://paradisegroupx.com

# Quote form delivery. Set ONE of these; with neither, the form logs to the
# server console and still shows success (demo mode).
# 1) Formspree: the endpoint the current site already uses
FORMSPREE_ENDPOINT=
# 2) Resend: API key + where leads go (comma-separated) + verified sender
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
